// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "codex-acp": {
      "default_config_options": {
        "model": "gpt-6.1-sol"
      },
      "type": "registry"
    },
    "claude-acp": {
      "type": "registry"
    }
  },
  "format_on_save": "on",
  "cli_default_open_behavior": "existing_window",
  "language_models": {
    "openai_compatible": {
      
    }
  },
  "proxy": "",
  "buffer_font_family": "UbuntuSansMono Nerd Font",
  "terminal": {
    "font_family": "UbuntuSansMono Nerd Font"
  },
  "which_key": {
    "delay_ms": 200,
    "enabled": true
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "project_panel": {
    "dock": "right"
  },
  "outline_panel": {
    "dock": "right"
  },
  "collaboration_panel": {
    "dock": "right"
  },
  "agent": {
    "sandbox_permissions": {
      "network_hosts": [
        "support.blizzard.com",
        "us.support.blizzard.com",
        "surge.bojin.co",
        "testingcf.jsdelivr.net"
      ]
    },
    "default_model": {
      "effort": "medium",
      "provider": "openai-subscribed",
      "model": "gpt-6.1-sol",
      "enable_thinking": true
    },
    "dock": "left",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "right"
  },
  "icon_theme": {
    "mode": "system",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "vim_mode": true,
  "session": {
    "trust_all_worktrees": true
  },
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
}
